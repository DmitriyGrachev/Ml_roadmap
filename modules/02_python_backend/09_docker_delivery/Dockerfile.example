FROM ghcr.io/astral-sh/uv:0.12.17 AS uv
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:${PATH}" \
    APP_MODULE="replace.with.your.application:app"

COPY --from=uv /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY . .
RUN uv sync --frozen --no-dev \
    && useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app /opt/venv

USER appuser
EXPOSE 8000

# Override APP_MODULE with the completed ASGI module; keep it out of this teaching example.
CMD ["sh", "-c", "exec uv run --no-sync uvicorn \"${APP_MODULE}\" --host 0.0.0.0 --port 8000"]
