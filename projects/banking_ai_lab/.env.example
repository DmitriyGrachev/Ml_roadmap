# Copy this file to .env for local-only use; replace every placeholder before sharing.
BANKING_DATABASE_URL=sqlite:///./banking_ai_lab.db
BANKING_LOG_LEVEL=INFO
BANKING_API_PREFIX=/api
BANKING_POSTGRES_USER=banking_user
BANKING_POSTGRES_PASSWORD=replace-with-a-local-only-password
BANKING_POSTGRES_DB=banking_ai_lab
BANKING_POSTGRES_PORT=5432
BANKING_APP_PORT=8000
ROADMAP_POSTGRES_URL=postgresql+psycopg://banking_user:replace-with-a-local-only-password@127.0.0.1:5432/banking_ai_lab
