      "text": "The second floor is open until six this week.",
      "label": "access",
      "source_id": "author-library-v1",
      "group_id": "floor-hours",
      "content_sha256": "e8a48a3ef291b9b67c4af18caf9372fd7cc1172be48a3a767b2b67324151cb1f"
    },
    {
      "row_id": "n12",
      "text": "The chess club meets in the library on Tuesday.",
      "label": "event",
      "source_id": "author-library-v1",
      "group_id": "chess-event",
      "content_sha256": "102fb8da62f33a2d475e95becead504bf56710b0ddf50c2d4affa551128b4e30"
    },
    {
      "row_id": "n13",
      "text": "You can extend a book loan once.",
