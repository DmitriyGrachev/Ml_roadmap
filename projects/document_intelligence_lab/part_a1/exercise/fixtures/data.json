      "content_sha256": "9975ba92846fd09cb6d5e61e21c65ee9ec5b0a3b8dca3b2d2ef06482429f7a18"
    },
    {
      "row_id": "n04",
      "text": "The library opens at nine on Mondays.",
      "label": "access",
      "source_id": "author-library-v1",
      "group_id": "monday-hours",
      "content_sha256": "3186b6a3efe33f0157a5f6f40e2279751e4ae8e53bce1057878b687f6fec15ff"
    },
    {
      "row_id": "n05",
      "text": "Monday visitors may enter the library from nine.",
      "label": "access",
      "source_id": "author-library-v1",
      "group_id": "monday-hours",
      "content_sha256": "be5e4728b5ab11864bf98e1bd5048016728a71f1e8ab00df4f25117ebd7a041d"
    },
    {
      "row_id": "n06",
      "text": "Use the west entrance while the front door is repaired.",
      "label": "access",
      "source_id": "author-library-v1",
      "group_id": "entrance-repair",
      "content_sha256": "5d3c79d76978f28d7e1f012863668dc77b4045c7bade3240b12ff0298f806f58"
    },
    {
      "row_id": "n07",
      "text": "Join the poetry reading on Friday evening.",
      "label": "event",
      "source_id": "author-library-v1",
      "group_id": "poetry-reading",
      "content_sha256": "4286dc5e318d78ee834b31c9d0f9fa92432b7c37be101c4efe94b3a925eb2927"
    },
    {
      "row_id": "n08",
      "text": "All visitors are welcome at the Friday evening poetry reading.",
      "label": "event",
      "source_id": "author-library-v1",
      "group_id": "poetry-reading",
      "content_sha256": "2116c55789f6ab9646fc3a046b501d259ab532cf41b04166ca2cef6e2826104d"
    },
    {
      "row_id": "n09",
      "text": "Register at the desk for the storytelling workshop.",
      "label": "event",
      "source_id": "author-library-v1",
      "group_id": "storytelling",
      "content_sha256": "5deb4cbe40f43628c20da678d4db43bd1eeba321c88d2d5972d55736818fb6f3"
    },
    {
      "row_id": "n10",
      "text": "A borrowed map must be returned within seven days.",
      "label": "borrowing",
      "source_id": "author-library-v1",
      "group_id": "map-loan",
