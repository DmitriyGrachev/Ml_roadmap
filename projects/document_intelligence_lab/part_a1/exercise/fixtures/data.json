  "records": [
    {
      "row_id": "n01",
      "text": "Borrow up to three books for fourteen days.",
      "label": "borrowing",
      "source_id": "author-library-v1",
      "group_id": "loan-limit",
      "content_sha256": "8aa62c3dca838c5dfae1ed24a10295e8ee61a11e979d0592aed6ad58d09859e7"
    },
    {
      "row_id": "n02",
      "text": "Each reader may take three books for a two-week loan.",
      "label": "borrowing",
      "source_id": "author-library-v1",
      "group_id": "loan-limit",
      "content_sha256": "5560b30aa96e5544e43699408b16af8d80c2076087c59d8bb68cf40874681365"
    },
    {
